---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/photos/hero-coral-block.png';
---

<section id="top" class="hero">
	<div class="hero-grid">
		<div class="hero-content">
			<h1 class="headline">
				<span>Grace</span>
				<span>Lakey</span>
			</h1>
			<p class="tagline">Auctioneer &amp; emcee with a flair for style, entertainment, &amp; raising money</p>
			<p class="sparkle-line">Add a little sparkle. Raise a lot of money.</p>

			<div class="hero-actions">
				<a href="#book" class="button">check availability</a>
				<a href="#services" class="see-more">see how I work</a>
			</div>
		</div>

		<div class="hero-visual">
			<Image
				src={heroPhoto}
				alt="Grace Lakey smiling in a black suit with feathered cuffs, hands in her hair"
				class="hero-photo"
				widths={[400, 646]}
				sizes="(min-width: 901px) 700px, min(100vw, 420px)"
				format="webp"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		background-color: var(--cream);
		color: var(--ink);
		padding: 3rem 1.5rem 0;
		overflow: hidden;
	}

	.hero-grid {
		max-width: 72rem;
		margin: 0 auto;
		display: grid;
		gap: 2.5rem;
	}

	.hero-content {
		align-self: center;
	}

	.headline {
		color: var(--ink);
		font-size: clamp(4.5rem, 22vw, 9rem);
		margin-bottom: 1.5rem;
	}

	.headline span {
		display: block;
	}

	.tagline {
		color: var(--crimson);
		font-size: clamp(1rem, 2.5vw, 1.25rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 1.4;
		max-width: 30rem;
		margin-bottom: 1rem;
	}

	.sparkle-line {
		color: var(--ink);
		font-family: 'DM Sans', sans-serif;
		font-size: 1.15rem;
		font-style: italic;
		line-height: 1.5;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem 2rem;
		margin-top: 2rem;
	}

	.see-more {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.25rem;
	}

	.see-more:hover {
		color: var(--crimson);
	}

	.hero-visual {
		width: min(100%, 420px);
		margin: 0 auto;
	}

	.hero-visual :global(.hero-photo) {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
	}

	@media (min-width: 901px) {
		.hero {
			min-height: calc(100svh - var(--nav-height));
			display: flex;
			align-items: center;
			padding: 1.5rem 1.5rem 0;
		}

		.hero-grid {
			width: 100%;
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			align-items: center;
			gap: 3rem;
		}

		.hero-content {
			align-self: center;
			padding-bottom: 0;
		}

		.hero-visual {
			width: auto;
			height: 85vh;
			max-height: 85vh;
			max-width: 100%;
			margin: 0 0 0 auto;
			display: flex;
			align-items: center;
			justify-content: flex-end;
		}

		.hero-visual :global(.hero-photo) {
			width: auto;
			height: 85vh;
			max-height: 85vh;
			max-width: 100%;
			object-fit: contain;
		}
	}

	@media (max-width: 480px) {
		.hero-actions {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
