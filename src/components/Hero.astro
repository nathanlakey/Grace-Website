---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/photos/hero-cutout.png';
---

<section id="top" class="hero">
	<div class="hero-grid">
		<div class="hero-content">
			<h1 class="headline">
				<span>Grace</span>
				<span>Lakey</span>
			</h1>
			<p class="tagline">Auctioneer &amp; emcee with a flair for style, entertainment, &amp; raising money</p>
			<p class="small-line">Polished. Powerful. Profitable.</p>
			<p class="small-line">Add a little sparkle. Raise a lot of money.</p>

			<div class="hero-actions">
				<a href="#book" class="button">check availability</a>
				<a href="#services" class="see-more">see how I work</a>
			</div>
		</div>

		<div class="hero-visual">
			<div class="hero-block"></div>
			<Image
				src={heroPhoto}
				alt="Grace Lakey smiling in a black suit with feathered cuffs, hands in her hair"
				class="hero-photo"
				widths={[400, 800, 1200]}
				sizes="(min-width: 901px) 512px, (min-width: 481px) 448px, 100vw"
				format="webp"
				loading="eager"
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		background-color: var(--cream);
		color: var(--ink);
		padding: 4rem 1.5rem 0;
		overflow: hidden;
	}

	.hero-grid {
		max-width: 72rem;
		margin: 0 auto;
		display: grid;
		gap: 3rem;
	}

	.hero-content {
		align-self: center;
	}

	.headline {
		color: var(--ink);
		font-size: clamp(4.5rem, 22vw, 9rem);
		margin-bottom: 1.5rem;
	}

	.headline span {
		display: block;
	}

	.tagline {
		color: var(--crimson);
		font-size: clamp(1rem, 2.5vw, 1.25rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 1.4;
		max-width: 30rem;
		margin-bottom: 1rem;
	}

	.small-line {
		color: var(--ink);
		font-size: 0.95rem;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem 2rem;
		margin-top: 2rem;
	}

	.see-more {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.25rem;
	}

	.see-more:hover {
		color: var(--crimson);
	}

	.hero-visual {
		position: relative;
		width: min(100%, 28rem);
		aspect-ratio: 990 / 1394;
		margin: 0 auto;
	}

	.hero-block {
		position: absolute;
		left: 6%;
		right: 6%;
		bottom: 0;
		height: 86%;
		background-color: var(--coral);
		border-radius: 1rem 1rem 0 0;
	}

	.hero-visual :global(.hero-photo) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: bottom;
	}

	@media (min-width: 901px) {
		.hero {
			min-height: calc(100svh - var(--nav-height));
			display: flex;
			align-items: stretch;
			padding-top: 2rem;
		}

		.hero-grid {
			width: 100%;
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			align-items: end;
			gap: 3rem;
		}

		.hero-content {
			align-self: center;
			padding-bottom: 4rem;
		}

		.hero-visual {
			width: min(100%, 32rem, 46svh);
			margin: 0 0 0 auto;
		}
	}

	@media (max-width: 480px) {
		.hero-actions {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
