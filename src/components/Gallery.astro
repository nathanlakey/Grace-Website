---
import { Image } from 'astro:assets';
import { galleryPhotos } from '../data/gallery';
import Confetti from './Confetti.astro';
---

<section id="gallery" class="gallery">
	<div class="gallery-inner">
		<h2>Gallery</h2>
		<Confetti position="top-right" size="6rem" rotation={-4} />

		<ul class="gallery-grid">
			{galleryPhotos.map((photo, index) => (
				<li class="gallery-item">
					<button type="button" class="gallery-trigger" data-index={index}>
						<Image src={photo.src} alt={photo.alt} loading="lazy" />
					</button>
				</li>
			))}
		</ul>
	</div>

	<Confetti position="bottom-left" size="6rem" rotation={6} />

	<dialog class="lightbox" aria-label="Photo gallery">
		<button type="button" class="lightbox-close" aria-label="close">&times;</button>
		<button type="button" class="lightbox-prev" aria-label="previous photo">&#8249;</button>
		<img class="lightbox-image" src="" alt="" />
		<button type="button" class="lightbox-next" aria-label="next photo">&#8250;</button>
	</dialog>
</section>

<script>
	const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-trigger'));
	const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
	const lightboxImage = dialog?.querySelector<HTMLImageElement>('.lightbox-image');
	const prevButton = dialog?.querySelector<HTMLButtonElement>('.lightbox-prev');
	const nextButton = dialog?.querySelector<HTMLButtonElement>('.lightbox-next');
	const closeButton = dialog?.querySelector<HTMLButtonElement>('.lightbox-close');

	let currentIndex = 0;
	let lastTrigger: HTMLButtonElement | null = null;

	function show(index: number) {
		currentIndex = (index + triggers.length) % triggers.length;
		const img = triggers[currentIndex].querySelector('img');
		if (img && lightboxImage) {
			lightboxImage.src = img.currentSrc || img.src;
			lightboxImage.alt = img.alt;
		}
	}

	function openLightbox(index: number, trigger: HTMLButtonElement) {
		lastTrigger = trigger;
		show(index);
		dialog?.showModal();
	}

	triggers.forEach((trigger, index) => {
		trigger.addEventListener('click', () => openLightbox(index, trigger));
	});

	prevButton?.addEventListener('click', () => show(currentIndex - 1));
	nextButton?.addEventListener('click', () => show(currentIndex + 1));
	closeButton?.addEventListener('click', () => dialog?.close());

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	dialog?.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowLeft') show(currentIndex - 1);
		if (event.key === 'ArrowRight') show(currentIndex + 1);
	});

	dialog?.addEventListener('close', () => {
		// defer so it runs after the browser's own post-click focus handling
		setTimeout(() => lastTrigger?.focus(), 0);
	});
</script>

<style>
	.gallery {
		position: relative;
		background-color: var(--cream);
		color: var(--ink);
		padding: 6rem 1.5rem;
	}

	.gallery-inner {
		position: relative;
		max-width: 72rem;
		margin: 0 auto;
	}

	.gallery h2 {
		color: var(--ink);
		font-size: clamp(2.25rem, 5vw, 4rem);
		margin-bottom: 2.5rem;
	}

	.gallery-grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
	}

	.gallery-trigger {
		display: block;
		width: 100%;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
	}

	.gallery-trigger:focus-visible {
		outline: 3px solid var(--crimson);
		outline-offset: 2px;
	}

	.gallery-trigger :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center 20%;
	}

	@media (min-width: 641px) {
		.gallery-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.lightbox {
		border: none;
		padding: 0;
		margin: auto;
		background: transparent;
		max-width: 90vw;
		max-height: 90vh;
		overflow: visible;
	}

	.lightbox::backdrop {
		background-color: color-mix(in srgb, var(--ink) 85%, transparent);
	}

	.lightbox-image {
		display: block;
		max-width: 90vw;
		max-height: 90vh;
		width: auto;
		height: auto;
		border-radius: 0.5rem;
	}

	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;
		background-color: var(--ink);
		color: var(--cream);
		border: none;
		border-radius: 999px;
		cursor: pointer;
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.5rem;
		line-height: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox-close {
		top: -1.25rem;
		right: -1.25rem;
	}

	.lightbox-prev {
		left: -1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-next {
		right: -1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}
</style>
