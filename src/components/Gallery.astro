---
import { Image, getImage } from 'astro:assets';
import { galleryPhotos } from '../data/gallery';
import logoCoral from '../assets/brand/logo-coral.svg';
import logoCream from '../assets/brand/logo-cream.svg';
import Confetti from './Confetti.astro';

// Crop the Canva export's empty margins without changing the shared logo assets.
const sealView = '#svgView(viewBox(65,166,680,680))';

// larger copy for the lightbox, only fetched when a photo is opened
const fullSizeSrcs = await Promise.all(
	galleryPhotos.map(async (photo) => photo.kind === 'photo'
		? (await getImage({ src: photo.src, width: 1600, format: 'webp' })).src
		: undefined)
);
---

<section id="gallery" class="gallery">
	<div class="gallery-sweep" aria-hidden="true">
		<Confetti variant="sweep" />
	</div>
	<div class="gallery-inner">
		<ul class="gallery-grid">
			<li class="gallery-heading">
				<img src={logoCoral.src + sealView} alt="" class="section-seal" />
				<h2>Gallery</h2>
			</li>
			<li class="gallery-brand" aria-hidden="true">
				<img src={logoCoral.src + sealView} alt="" class="gallery-seal" />
			</li>
			{galleryPhotos.map((photo, index) => (
				<li class="gallery-item">
					{photo.kind === 'placeholder' ? (
						<div class="gallery-placeholder">
							<img src={logoCream.src + sealView} alt="" class="placeholder-seal" />
							<p>{photo.label}</p>
						</div>
					) : (
						<button type="button" class="gallery-trigger" data-full={fullSizeSrcs[index]}>
							<Image
								src={photo.src}
								alt={photo.alt}
								style={`object-position: ${photo.objectPosition};`}
								widths={[400, 800, 1200]}
								sizes="(min-width: 1248px) 381px, (min-width: 641px) calc((100vw - 104px) / 3), calc(100vw - 48px)"
								format="webp"
								loading="lazy"
								decoding="async"
							/>
						</button>
					)}
				</li>
			))}
		</ul>
	</div>

	<dialog class="lightbox" aria-label="Photo gallery">
		<button type="button" class="lightbox-close" aria-label="close">&times;</button>
		<button type="button" class="lightbox-prev" aria-label="previous photo">&#8249;</button>
		<img class="lightbox-image" src="" alt="" />
		<button type="button" class="lightbox-next" aria-label="next photo">&#8250;</button>
	</dialog>
</section>

<script>
	const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-trigger'));
	const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
	const lightboxImage = dialog?.querySelector<HTMLImageElement>('.lightbox-image');
	const prevButton = dialog?.querySelector<HTMLButtonElement>('.lightbox-prev');
	const nextButton = dialog?.querySelector<HTMLButtonElement>('.lightbox-next');
	const closeButton = dialog?.querySelector<HTMLButtonElement>('.lightbox-close');

	let currentIndex = 0;
	let lastTrigger: HTMLButtonElement | null = null;

	function show(index: number) {
		currentIndex = (index + triggers.length) % triggers.length;
		const trigger = triggers[currentIndex];
		const img = trigger.querySelector('img');
		if (img && lightboxImage) {
			lightboxImage.src = trigger.dataset.full || img.currentSrc || img.src;
			lightboxImage.alt = img.alt;
		}
	}

	function openLightbox(index: number, trigger: HTMLButtonElement) {
		lastTrigger = trigger;
		show(index);
		dialog?.showModal();
	}

	triggers.forEach((trigger, index) => {
		trigger.addEventListener('click', () => openLightbox(index, trigger));
	});

	prevButton?.addEventListener('click', () => show(currentIndex - 1));
	nextButton?.addEventListener('click', () => show(currentIndex + 1));
	closeButton?.addEventListener('click', () => dialog?.close());

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog) dialog.close();
	});

	dialog?.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
			event.preventDefault();
			show(currentIndex + (event.key === 'ArrowLeft' ? -1 : 1));
		}
		if (event.key === 'Escape') {
			event.preventDefault();
			dialog.close();
		}
	});

	dialog?.addEventListener('close', () => {
		// defer so it runs after the browser's own post-click focus handling
		setTimeout(() => lastTrigger?.focus(), 0);
	});
</script>

<style>
	.gallery {
		position: relative;
		isolation: isolate;
		overflow: clip;
		background-color: var(--cream);
		color: var(--ink);
		padding: 6rem 1.5rem;
	}

	.gallery-inner {
		position: relative;
		z-index: 1;
		max-width: 75rem;
		margin: 0 auto;
	}

	.gallery-sweep {
		position: absolute;
		top: 50%;
		right: -210px;
		width: 600px;
		height: 180px;
		transform: translateY(-50%) rotate(90deg);
		pointer-events: none;
	}

	.gallery h2 {
		color: var(--ink);
		font-size: clamp(2.25rem, 5vw, 4rem);
	}

	.gallery-grid {
		list-style: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.75rem;
	}

	.gallery-heading {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.gallery-heading .section-seal {
		object-fit: fill;
	}

	.gallery-brand {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.gallery-seal {
		width: 200px;
		height: 200px;
		object-fit: fill;
	}

	.gallery-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 4 / 3;
		background-color: var(--crimson);
		color: var(--cream);
		font-size: 0.875rem;
	}

	.placeholder-seal {
		width: 40%;
		aspect-ratio: 1;
		object-fit: fill;
		margin-bottom: 0.75rem;
	}

	.gallery-trigger {
		display: block;
		width: 100%;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		aspect-ratio: 4 / 3;
		border-radius: 0;
	}

	.gallery-trigger:focus-visible {
		outline: 3px solid var(--crimson);
		outline-offset: 2px;
	}

	.gallery-trigger :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 0;
	}

	@media (min-width: 641px) {
		.gallery-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.gallery-seal {
			width: 340px;
			height: auto;
			aspect-ratio: 1;
		}
	}

	.lightbox {
		border: none;
		padding: 0;
		margin: auto;
		background: transparent;
		max-width: 90vw;
		max-height: 90vh;
		overflow: visible;
	}

	.lightbox::backdrop {
		background-color: color-mix(in srgb, var(--ink) 85%, transparent);
	}

	.lightbox-image {
		display: block;
		max-width: 90vw;
		max-height: 90vh;
		width: auto;
		height: auto;
		border-radius: 0;
	}

	.lightbox-close,
	.lightbox-prev,
	.lightbox-next {
		position: absolute;
		background-color: var(--ink);
		color: var(--cream);
		border: none;
		border-radius: 999px;
		cursor: pointer;
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.5rem;
		line-height: 1;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox button:focus-visible {
		outline: 3px solid var(--coral);
		outline-offset: 3px;
	}

	.lightbox-close {
		top: -1.25rem;
		right: -1.25rem;
	}

	.lightbox-prev {
		left: -1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-next {
		right: -1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	@media (max-width: 640px) {
		.lightbox-prev {
			left: 0.5rem;
		}

		.lightbox-next {
			right: 0.5rem;
		}
	}
</style>
