---
import { Image } from 'astro:assets';
import bandPhoto from '../assets/photos/headshot-1.jpeg';
import logoSeal from '../assets/brand/logo-coral.svg';
---

<section class="photo-band">
	<Image
		src={bandPhoto}
		alt="Grace Lakey smiling in a black blazer with a polka-dot top"
		class="band-photo"
		widths={[640, 1024, 1600, 2048]}
		sizes="100vw"
	/>
	<img src={logoSeal.src} alt="Grace Lakey logo seal" class="band-logo" />
</section>

<style>
	.photo-band {
		position: relative;
		background-color: var(--cream);
		width: 100%;
		height: 260px;
		overflow: hidden;
	}

	.photo-band :global(img.band-photo) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 20%;
	}

	.band-logo {
		position: absolute;
		top: 1rem;
		left: 1rem;
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	@media (min-width: 641px) {
		.photo-band {
			height: 420px;
		}

		.photo-band :global(img.band-photo) {
			object-fit: contain;
		}

		.band-logo {
			top: 1.5rem;
			left: 1.5rem;
		}
	}
</style>
