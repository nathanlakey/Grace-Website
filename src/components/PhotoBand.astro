---
import { Image } from 'astro:assets';
import bandPhoto from '../assets/photos/headshot-1.jpeg';
import logoSeal from '../assets/brand/logo-coral.svg';
---

<section class="photo-band">
	<Image
		src={bandPhoto}
		alt="Grace Lakey smiling in a black blazer with a polka-dot top"
		class="band-photo"
		widths={[400, 800, 1200]}
		sizes={`(min-width: 641px) ${Math.ceil(420 * bandPhoto.width / bandPhoto.height)}px, ${Math.ceil(280 * bandPhoto.width / bandPhoto.height)}px`}
		format="webp"
		loading="lazy"
		decoding="async"
	/>
	<div class="band-inner">
		<img src={logoSeal.src} alt="Grace Lakey logo seal" class="band-logo" />
	</div>
</section>

<style>
	.photo-band {
		position: relative;
		background-color: var(--photo-wall);
		width: 100%;
		height: 280px;
		overflow: hidden;
	}

	.photo-band :global(img.band-photo) {
		display: block;
		width: auto;
		height: 100%;
		margin: 0 auto;
		object-fit: contain;
		object-position: center 20%;
		mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
		-webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
	}

	.band-inner {
		position: absolute;
		inset: 1.5rem 1.5rem auto;
		max-width: 72rem;
		margin: 0 auto;
	}

	.band-logo {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	@media (min-width: 641px) {
		.photo-band {
			height: 420px;
		}
	}
</style>
