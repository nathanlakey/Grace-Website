---
import { Image } from 'astro:assets';
import bandPhoto from '../assets/photos/photo-band-wide.jpg';
import logoSeal from '../assets/brand/logo-coral-clean.svg';
---

<section class="photo-band">
	<Image
		src={bandPhoto}
		alt="Grace Lakey standing in a black suit"
		class="band-photo"
		widths={[400, 800, 1200, 1600, 2000]}
		sizes="100vw"
		format="webp"
		loading="lazy"
		decoding="async"
	/>
	<div class="band-inner">
		<img src={logoSeal.src} alt="Grace Lakey logo seal" class="band-logo" />
	</div>
</section>

<style>
	.photo-band {
		position: relative;
		width: 100%;
		height: 280px;
		overflow: hidden;
	}

	.photo-band :global(img.band-photo) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
	}

	.band-inner {
		position: absolute;
		inset: 1.5rem 1.5rem auto;
		max-width: 72rem;
		margin: 0 auto;
	}

	.band-logo {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	@media (min-width: 641px) {
		.photo-band {
			height: 420px;
		}
	}
</style>
