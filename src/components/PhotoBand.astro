---
import { Image } from 'astro:assets';
import bandPhoto from '../assets/photos/photo-band-wide.jpg';
---

<section class="photo-band">
	<Image
		src={bandPhoto}
		alt="Grace Lakey standing in a black suit"
		class="band-photo"
		widths={[400, 800, 1200, 1600, 2000]}
		sizes="100vw"
		format="webp"
		loading="lazy"
		decoding="async"
	/>
</section>

<style>
	.photo-band {
		position: relative;
		width: 100%;
		height: 280px;
		overflow: hidden;
	}

	.photo-band :global(img.band-photo) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
	}

	@media (min-width: 641px) {
		.photo-band {
			height: 420px;
		}
	}
</style>
