---
import type { FormField } from '../data/bookingForm';

interface Props {
	field: FormField;
	/** A paired checkbox (like date_flexible) rendered inline below this field's input. */
	pairedCheckbox?: FormField;
}

const { field, pairedCheckbox } = Astro.props;
const servicesAttr = field.services?.join(',');
const widthClass = `field--${field.width ?? 'half'}`;
const errorId = `${field.id}-error`;
const groupId = `${field.id}-group`;
---

{field.type === 'checkboxes' || field.type === 'radio' ? (
	<fieldset
		class={`form-field ${widthClass}`}
		id={groupId}
		data-step={field.step}
		data-services={servicesAttr}
	>
		<legend>
			{field.label}
			{field.required && <span class="required-mark" aria-hidden="true"> *</span>}
		</legend>
		<div class="checkbox-grid">
			{field.options?.map((option) => (
				<label class="checkbox-row">
					<input
						type={field.type === 'radio' ? 'radio' : 'checkbox'}
						name={field.id}
						value={option.id}
					/>
					{option.label}
				</label>
			))}
		</div>
		{field.required && <p class="field-error" id={errorId} role="alert"></p>}
	</fieldset>
) : (
	<div class={`form-field ${widthClass}`} data-step={field.step} data-services={servicesAttr}>
		{field.type !== 'checkbox' && (
			<label for={field.id}>
				{field.label}
				{field.required && <span class="required-mark" aria-hidden="true"> *</span>}
			</label>
		)}

		{field.type === 'select' ? (
			<select id={field.id} name={field.id} required={field.required}>
				<option value="" selected disabled hidden></option>
				{field.options?.map((option) => (
					<option value={option.id}>{option.label}</option>
				))}
			</select>
		) : field.type === 'textarea' ? (
			<textarea
				id={field.id}
				name={field.id}
				required={field.required}
				placeholder={field.placeholder}
				rows={4}
			/>
		) : field.type === 'checkbox' ? (
			<label class="checkbox-row">
				<input type="checkbox" id={field.id} name={field.id} />
				{field.label}
			</label>
		) : (
			<input
				type={field.type}
				id={field.id}
				name={field.id}
				required={field.required}
				placeholder={field.placeholder}
			/>
		)}

		{pairedCheckbox && (
			<label class="checkbox-row checkbox-row--inline">
				<input
					type="checkbox"
					id={pairedCheckbox.id}
					name={pairedCheckbox.id}
					data-controls={pairedCheckbox.controlsFieldId}
				/>
				{pairedCheckbox.label}
			</label>
		)}

		{field.required && <p class="field-error" id={errorId} role="alert"></p>}
	</div>
)}

<style>
	.form-field {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		border: none;
		padding: 0;
		margin: 0;
	}

	.form-field[hidden] {
		display: none;
	}

	.form-field label,
	.form-field legend {
		font-weight: 700;
		font-size: 0.95rem;
	}

	.required-mark {
		color: var(--crimson);
	}

	.form-field input[type='text'],
	.form-field input[type='email'],
	.form-field input[type='tel'],
	.form-field input[type='date'],
	.form-field select {
		width: 100%;
		padding: 0.75rem 1rem;
		border-radius: 999px;
		border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
		background-color: var(--cream);
		color: var(--ink);
	}

	.form-field textarea {
		width: 100%;
		padding: 0.75rem 1rem;
		border-radius: 1rem;
		border: 1.5px solid color-mix(in srgb, var(--ink) 25%, transparent);
		background-color: var(--cream);
		color: var(--ink);
		resize: vertical;
		font-family: inherit;
	}

	.form-field input:disabled,
	.form-field select:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.form-field input:focus-visible,
	.form-field select:focus-visible,
	.form-field textarea:focus-visible {
		outline: 3px solid var(--coral);
		outline-offset: 2px;
	}

	.field-error {
		display: none;
		color: var(--crimson);
		font-size: 0.85rem;
		font-weight: 500;
	}

	.field-error.is-visible {
		display: block;
	}

	.checkbox-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 500;
		cursor: pointer;
	}

	.checkbox-row--inline {
		margin-top: 0.25rem;
		font-size: 0.9rem;
	}

	.checkbox-row input {
		width: 1.1rem;
		height: 1.1rem;
		accent-color: var(--coral);
		flex-shrink: 0;
	}

	.checkbox-row input:focus-visible {
		outline: 3px solid var(--coral);
		outline-offset: 2px;
	}

	.checkbox-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	.field--full {
		grid-column: 1 / -1;
	}

	@media (min-width: 641px) {
		.checkbox-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
