---
import Confetti from './Confetti.astro';
import SocialLinks from './SocialLinks.astro';
import { contactEmail } from '../data/site';
---

<footer class="site-footer">
	<div class="footer-main">
		<div class="footer-sweep" aria-hidden="true">
			<Confetti variant="sweep" />
		</div>

		<div class="footer-inner">
			<div class="footer-left">
				<div class="cta-row">
					<h2>Work with me</h2>
					<a href="#book" class="button">check availability</a>
				</div>

				<div class="email-block">
					<p class="email-label">Email</p>
					<a href={`mailto:${contactEmail}`} class="email-link">{contactEmail}</a>
				</div>
			</div>

			<div class="footer-right">
				<SocialLinks />
				<p class="social-caption">Learn more about me and my work on social media.</p>
			</div>
		</div>
	</div>

	<div class="footer-bottom">
		<div class="footer-bottom-inner">
			<p>&copy; {new Date().getFullYear()} Grace Lakey</p>
			<p>Some links on this site are affiliate links.</p>
		</div>
	</div>
</footer>

<style>
	.footer-main {
		position: relative;
		isolation: isolate;
		background-color: var(--cream);
		color: var(--ink);
		padding: 5rem 1.5rem 4rem;
	}

	.footer-sweep {
		position: absolute;
		top: -6rem;
		right: max(1.5rem, calc((100% - 72rem) / 2));
		width: min(500px, calc(100% - 3rem));
		height: 180px;
		z-index: -1;
		pointer-events: none;
	}

	.footer-inner {
		position: relative;
		z-index: 2;
		max-width: 72rem;
		margin: 0 auto;
		display: grid;
		gap: 3rem;
	}

	.cta-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.cta-row h2 {
		color: var(--crimson);
		font-size: clamp(2rem, 4.5vw, 3.25rem);
	}

	.email-label {
		font-weight: 700;
		margin-bottom: 0.25rem;
	}

	.email-link {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.25rem;
	}

	.email-link:hover {
		color: var(--crimson);
	}

	.email-link:focus-visible {
		outline: 3px solid var(--crimson);
		outline-offset: 2px;
	}

	.social-caption {
		margin-top: 1rem;
		color: var(--crimson);
		font-size: 0.85rem;
		max-width: 20rem;
	}

	@media (min-width: 901px) {
		.footer-inner {
			grid-template-columns: 1.3fr 1fr;
			align-items: start;
		}

		.footer-right {
			justify-self: end;
			text-align: right;
		}

		.footer-right :global(.social-list) {
			justify-content: flex-end;
		}

		.social-caption {
			margin-left: auto;
		}
	}

	@media (max-width: 480px) {
		.cta-row {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.footer-bottom {
		background-color: var(--ink);
		color: var(--cream);
		padding: 1rem 1.5rem;
	}

	.footer-bottom-inner {
		max-width: 72rem;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		font-size: 0.8rem;
	}
</style>
