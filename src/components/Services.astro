---
import { services } from '../data/services';
import Glitter from './Glitter.astro';
---

<section id="services" class="services">
	<div class="services-inner">
		<div class="services-sweep" aria-hidden="true">
			<Glitter />
		</div>
		<h2>My Services</h2>
		<p class="services-hint">tap a service to explore</p>
		<!-- TODO: intro text between "My Services" heading and the tiles — not found in docs/copy.md -->

		<ul class="tiles">
			{services.map((service, index) => (
				<li class="tile" data-color={service.color}>
					<button
						type="button"
						class="tile-toggle"
						aria-expanded={index === 0 ? 'true' : 'false'}
						aria-controls={`service-panel-${index}`}
						id={`service-toggle-${index}`}
					>
						<span class="tile-title">{service.title}</span>
						<span class="tile-icon" aria-hidden="true"></span>
					</button>

					<div class="tile-panel-wrap">
						<div
							class="tile-panel"
							id={`service-panel-${index}`}
							role="region"
							aria-labelledby={`service-toggle-${index}`}
							aria-hidden={index !== 0}
						>
							{service.description.map((paragraph) => (
								<p>{paragraph}</p>
							))}
							{service.bullets && (
								<ul class="tile-bullets">
									{service.bullets.map((bullet) => (
										<li>{bullet}</li>
									))}
								</ul>
							)}
						</div>
					</div>
				</li>
			))}
		</ul>

		<p class="services-closing">
			Book me for all of it or just the part you need. We'll build the booking around your event.
		</p>
		<a href="#book" class="button">check availability</a>
	</div>
</section>

<script>
	const toggles = document.querySelectorAll<HTMLButtonElement>('.tile-toggle');

	function setPanelState(toggle: HTMLButtonElement, isOpen: boolean) {
		toggle.setAttribute('aria-expanded', String(isOpen));
		const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
		panel?.setAttribute('aria-hidden', String(!isOpen));
	}

	toggles.forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true';
			toggles.forEach((other) => setPanelState(other, false));
			if (!isOpen) setPanelState(toggle, true);
		});
	});
</script>

<style>
	.services {
		position: relative;
		isolation: isolate;
		overflow: clip;
		background-color: var(--cream);
		color: var(--ink);
		padding: 6rem 1.5rem;
	}

	.services-inner {
		position: relative;
		max-width: 72rem;
		margin: 0 auto;
	}

	.services-sweep {
		position: absolute;
		top: -3.5rem;
		right: 0;
		width: min(360px, 45%);
		height: 80px;
		z-index: -1;
		transform: rotate(-8deg);
		pointer-events: none;
	}

	.services h2 {
		color: var(--crimson);
		font-size: clamp(2.25rem, 5vw, 4rem);
		margin-bottom: 1rem;
	}

	.services-hint {
		text-transform: lowercase;
		color: color-mix(in srgb, var(--ink) 70%, transparent);
		margin-bottom: 2rem;
	}

	.services-closing {
		max-width: 42rem;
		margin-bottom: 1.5rem;
		font-family: 'Montserrat', sans-serif;
		font-weight: 800;
		font-size: clamp(1.25rem, 2vw, 1.5rem);
	}

	.tiles {
		list-style: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: 1.5rem;
		margin-bottom: 3rem;
	}

	.tile {
		overflow: hidden;
		background-color: var(--tile-bg);
		color: var(--tile-text);
	}

	.tile[data-color='crimson'] {
		--tile-bg: var(--crimson);
		--tile-text: var(--cream);
	}

	.tile[data-color='mustard-light'] {
		--tile-bg: var(--mustard-light);
		--tile-text: var(--ink);
	}

	.tile[data-color='charcoal'] {
		--tile-bg: var(--charcoal);
		--tile-text: var(--cream);
	}

	.tile[data-color='pink'] {
		--tile-bg: var(--pink);
		--tile-text: var(--ink);
	}

	.tile-toggle {
		position: relative;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.75rem 3.5rem 1.75rem 1.75rem;
		background: none;
		border: none;
		color: inherit;
		text-align: left;
		cursor: pointer;
	}

	.tile-toggle:focus-visible {
		outline: 3px solid currentColor;
		outline-offset: -6px;
	}

	.tile-title {
		font-family: 'Montserrat', sans-serif;
		font-weight: 800;
		font-size: clamp(1.125rem, 1.8vw, 1.5rem);
		line-height: 1.2;
		overflow-wrap: anywhere;
	}

	.tile-icon {
		position: absolute;
		top: 50%;
		right: 1.75rem;
		width: 1.1rem;
		height: 1.1rem;
		transform: translateY(-50%);
		transition: transform 0.2s ease;
	}

	.tile-icon::before,
	.tile-icon::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		background-color: currentColor;
		transform: translate(-50%, -50%);
	}

	.tile-icon::before {
		width: 100%;
		height: 2px;
	}

	.tile-icon::after {
		width: 2px;
		height: 100%;
	}

	.tile-toggle[aria-expanded='true'] .tile-icon {
		transform: translateY(-50%) rotate(45deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.tile-icon {
			transition: none;
		}
	}

	.tile-panel-wrap {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 220ms ease;
	}

	.tile-toggle[aria-expanded='true'] + .tile-panel-wrap {
		grid-template-rows: 1fr;
	}

	.tile-panel {
		overflow: hidden;
		min-height: 0;
		padding: 0 1.75rem;
		visibility: hidden;
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 220ms ease, transform 220ms ease, visibility 0s linear 220ms;
	}

	.tile-toggle[aria-expanded='true'] + .tile-panel-wrap .tile-panel {
		padding-bottom: 1.75rem;
		visibility: visible;
		opacity: 1;
		transform: translateY(0);
		transition: opacity 220ms ease, transform 220ms ease, visibility 0s linear 0s;
	}

	@media (prefers-reduced-motion: reduce) {
		.tile-panel-wrap,
		.tile-panel {
			transition: none;
		}
	}

	.tile-panel p {
		margin-bottom: 1rem;
	}

	.tile-panel p:last-child {
		margin-bottom: 0;
	}

	.tile-bullets {
		margin-top: 1rem;
		padding-left: 1.25rem;
	}

	.tile-bullets li {
		margin-bottom: 0.5rem;
	}
</style>
