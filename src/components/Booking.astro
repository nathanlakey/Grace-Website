---
import BookingField from './BookingField.astro';
import { bookingFields } from '../data/bookingForm';
import { contactEmail } from '../data/site';

const step1Fields = bookingFields.filter((field) => field.step === 1);
const checkboxControllers = new Map(
	step1Fields.filter((field) => field.controlsFieldId).map((field) => [field.controlsFieldId, field])
);
const step1MainFields = step1Fields.filter((field) => !field.controlsFieldId);

const step2Fields = bookingFields.filter((field) => field.step === 2);
const step3Fields = bookingFields.filter((field) => field.step === 3);
---

<section id="book" class="booking">
	<div class="booking-inner">
		<h2>Check availability</h2>

		<div class="booking-card">
			<p class="step-indicator" id="step-indicator">Step 1 of 3</p>

			<form class="booking-form" id="booking-form" novalidate>
				<div class="form-step" data-step="1">
					<div class="form-grid">
						{step1MainFields.map((field) => (
							<BookingField field={field} pairedCheckbox={checkboxControllers.get(field.id)} />
						))}
					</div>

					<div class="form-actions">
						<button type="button" class="button" id="step1-next">next</button>
					</div>
				</div>

				<div class="form-step" data-step="2" hidden>
					<div class="form-grid">
						{step2Fields.map((field) => (
							<BookingField field={field} />
						))}
					</div>

					<div class="form-actions form-actions--split">
						<button type="button" class="button button--ghost" id="step2-back">back</button>
						<button type="button" class="button" id="step2-next">next</button>
					</div>
				</div>

				<div class="form-step" data-step="3" hidden>
					<div class="form-grid">
						{step3Fields.map((field) => (
							<BookingField field={field} />
						))}
					</div>

					<div class="form-actions form-actions--split">
						<button type="button" class="button button--ghost" id="step3-back">back</button>
						<button type="button" class="button" id="step3-submit">submit</button>
					</div>
				</div>
			</form>
		</div>

		<p class="general-inquiries">
			General inquiries (press, schools, auctionStream):{' '}
			<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
		</p>
	</div>
</section>

<script>
	const TOTAL_STEPS = 3;
	const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	const card = document.querySelector<HTMLElement>('.booking-card');
	const stepIndicator = document.getElementById('step-indicator');
	const steps = Array.from(document.querySelectorAll<HTMLElement>('.form-step'));
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	function clearError(fieldId: string) {
		const errorEl = document.getElementById(`${fieldId}-error`);
		if (errorEl) errorEl.textContent = '';
		errorEl?.classList.remove('is-visible');

		document.getElementById(fieldId)?.removeAttribute('aria-invalid');
		document.getElementById(`${fieldId}-group`)?.removeAttribute('aria-invalid');
	}

	function showError(fieldId: string, message: string) {
		const errorEl = document.getElementById(`${fieldId}-error`);
		if (errorEl) {
			errorEl.textContent = message;
			errorEl.classList.add('is-visible');
		}

		document.getElementById(fieldId)?.setAttribute('aria-invalid', 'true');
		document.getElementById(`${fieldId}-group`)?.setAttribute('aria-invalid', 'true');
	}

	function validateStep1() {
		let valid = true;
		['name', 'email', 'organization', 'services'].forEach(clearError);

		const name = document.getElementById('name') as HTMLInputElement | null;
		if (!name?.value.trim()) {
			showError('name', 'Please enter your name.');
			valid = false;
		}

		const email = document.getElementById('email') as HTMLInputElement | null;
		if (!email?.value.trim()) {
			showError('email', 'Please enter your email.');
			valid = false;
		} else if (!EMAIL_PATTERN.test(email.value.trim())) {
			showError('email', 'Please enter a valid email address.');
			valid = false;
		}

		const organization = document.getElementById('organization') as HTMLInputElement | null;
		if (!organization?.value.trim()) {
			showError('organization', 'Please enter your organization.');
			valid = false;
		}

		const anyService = document.querySelector('input[name="services"]:checked');
		if (!anyService) {
			showError('services', 'Please select at least one service.');
			valid = false;
		}

		return valid;
	}

	function getSelectedServices() {
		return new Set(
			Array.from(document.querySelectorAll<HTMLInputElement>('input[name="services"]:checked')).map(
				(input) => input.value
			)
		);
	}

	function updateStep2Visibility() {
		const selected = getSelectedServices();

		document.querySelectorAll<HTMLElement>('[data-step="2"][data-services]').forEach((el) => {
			const services = el.dataset.services?.split(',') ?? [];
			el.hidden = !services.some((service) => selected.has(service));
		});
	}

	function focusFirstField(stepEl: HTMLElement) {
		const candidates = stepEl.querySelectorAll<HTMLElement>('input, select, textarea');
		for (const candidate of Array.from(candidates)) {
			if (candidate.offsetParent !== null) {
				candidate.focus();
				return;
			}
		}
	}

	function goToStep(step: number) {
		steps.forEach((stepEl) => {
			stepEl.hidden = Number(stepEl.dataset.step) !== step;
		});

		if (stepIndicator) stepIndicator.textContent = `Step ${step} of ${TOTAL_STEPS}`;

		if (step === 2) updateStep2Visibility();

		card?.scrollIntoView({
			behavior: prefersReducedMotion.matches ? 'auto' : 'smooth',
			block: 'start',
		});

		const activeStep = steps.find((stepEl) => Number(stepEl.dataset.step) === step);
		if (activeStep) focusFirstField(activeStep);
	}

	document.getElementById('step1-next')?.addEventListener('click', () => {
		if (validateStep1()) goToStep(2);
	});

	document.getElementById('step2-back')?.addEventListener('click', () => goToStep(1));
	document.getElementById('step2-next')?.addEventListener('click', () => goToStep(3));
	document.getElementById('step3-back')?.addEventListener('click', () => goToStep(2));
	// step3-submit intentionally has no handler yet

	// date_flexible disables event_date while checked, and clears its value
	const controllers = document.querySelectorAll<HTMLInputElement>('[data-controls]');
	controllers.forEach((controller) => {
		const targetId = controller.dataset.controls;
		const target = targetId ? document.getElementById(targetId) : null;
		if (!(target instanceof HTMLInputElement)) return;

		const syncDisabled = () => {
			target.disabled = controller.checked;
			if (controller.checked) target.value = '';
		};

		controller.addEventListener('change', syncDisabled);
		syncDisabled();
	});
</script>

<style>
	.booking {
		background-color: var(--cream);
		color: var(--ink);
		padding: 6rem 1.5rem;
	}

	.booking-inner {
		max-width: 720px;
		margin: 0 auto;
	}

	.booking h2 {
		color: var(--crimson);
		font-size: clamp(2.25rem, 5vw, 4rem);
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.booking-card {
		background-color: #fff;
		border-radius: 1rem;
		padding: 2rem 1.5rem;
		box-shadow: 0 4px 24px color-mix(in srgb, var(--ink) 10%, transparent);
		scroll-margin-top: calc(var(--nav-height) + 1rem);
	}

	.step-indicator {
		font-weight: 700;
		color: var(--charcoal);
		margin-bottom: 1.5rem;
	}

	.form-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		margin-bottom: 2rem;
	}

	.form-actions {
		display: flex;
		justify-content: flex-end;
		gap: 1rem;
	}

	.form-actions--split {
		justify-content: space-between;
	}

	.button--ghost {
		background-color: transparent;
		color: var(--crimson);
		border: 1.5px solid var(--crimson);
	}

	.button--ghost:hover {
		background-color: color-mix(in srgb, var(--crimson) 10%, transparent);
	}

	.general-inquiries {
		text-align: center;
		margin-top: 2rem;
		font-size: 0.95rem;
	}

	.general-inquiries a {
		color: var(--crimson);
		text-decoration: underline;
		text-underline-offset: 0.25rem;
	}

	@media (min-width: 641px) {
		.form-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
