---
// Decorative gold accents: corner clusters or a flowing diagonal sweep.
export interface Props {
	position?: 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
	size?: string;
	rotation?: number;
	showOnMobile?: boolean;
	variant?: 'corner' | 'sweep';
}

const { position = 'top-right', size = '8rem', rotation = 0, showOnMobile = false, variant = 'corner' } = Astro.props;

const GOLD_TONES = ['var(--gold-1)', 'var(--gold-2)', 'var(--gold-3)', 'var(--gold-4)'];
const VIEWBOX = 160;
const DOT_COUNT = variant === 'sweep' ? 60 : 40;

const dots = Array.from({ length: DOT_COUNT }, (_, index) => {
	// bias toward the corner so the cluster thins out as it sweeps across the diagonal
	const along = Math.pow(Math.random(), 0.6) * VIEWBOX;
	const jitter = (Math.random() - 0.5) * VIEWBOX * 0.5;
	const x = Math.min(VIEWBOX, Math.max(0, along + jitter * 0.7));
	const y = Math.min(VIEWBOX, Math.max(0, along - jitter * 0.7));
	const radius = 1 + Math.random() * 6; // 2px-14px diameter
	const opacity = 0.35 + Math.random() * 0.65; // some dots semi-transparent
	const fill = GOLD_TONES[Math.floor(Math.random() * GOLD_TONES.length)];
	if (variant === 'sweep') {
		const t = index / (DOT_COUNT - 1);
		const spread = 8 + 16 * Math.sin(Math.PI * t);
		return {
			x: 16 + 468 * t + (Math.random() - 0.5) * spread,
			y: 150 - 126 * t + 20 * Math.sin(Math.PI * t) + (Math.random() - 0.5) * spread,
			radius,
			opacity,
			fill,
		};
	}
	return { x, y, radius, opacity, fill };
});
---

<div
	class:list={['confetti', `confetti--${position}`, { 'confetti--mobile': showOnMobile, 'confetti--sweep': variant === 'sweep' }]}
	style={`--confetti-size: ${size}; --confetti-rotation: ${rotation}deg;`}
	aria-hidden="true"
>
	<svg viewBox={variant === 'sweep' ? '0 0 500 180' : `0 0 ${VIEWBOX} ${VIEWBOX}`} xmlns="http://www.w3.org/2000/svg" focusable="false">
		{dots.map((dot) => (
			<circle cx={dot.x} cy={dot.y} r={dot.radius} fill={dot.fill} opacity={dot.opacity} />
		))}
	</svg>
</div>

<style>
	.confetti {
		position: absolute;
		width: var(--confetti-size);
		height: var(--confetti-size);
		pointer-events: none;
		z-index: 1;
	}

	.confetti svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	.confetti--top-left {
		top: -0.75rem;
		left: 0.75rem;
		transform: rotate(var(--confetti-rotation, 0deg));
	}

	.confetti--top-right {
		top: -0.75rem;
		right: 0.75rem;
		transform: rotate(var(--confetti-rotation, 0deg)) scaleX(-1);
	}

	.confetti--bottom-left {
		bottom: -0.75rem;
		left: 0.75rem;
		transform: rotate(var(--confetti-rotation, 0deg)) scaleY(-1);
	}

	.confetti--bottom-right {
		bottom: -0.75rem;
		right: 0.75rem;
		transform: rotate(var(--confetti-rotation, 0deg)) scaleX(-1) scaleY(-1);
	}

	.confetti--sweep {
		inset: 0;
		width: 100%;
		height: 100%;
		transform: none;
		z-index: 0;
	}

	@media (max-width: 600px) {
		.confetti:not(.confetti--mobile) {
			display: none;
		}

		.confetti--sweep {
			display: none;
		}
	}
</style>
