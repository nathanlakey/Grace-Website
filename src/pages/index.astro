---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import Booking from '../components/Booking.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Footer from '../components/Footer.astro';
import { heroImage } from '../data/hero';

const heroPreload = await getImage({
	src: heroImage.src,
	widths: [...heroImage.widths],
	format: heroImage.format,
});
---

<BaseLayout>
	<link
		slot="head"
		rel="preload"
		as="image"
		type="image/webp"
		href={heroPreload.src}
		imagesrcset={heroPreload.srcSet.attribute}
		imagesizes={heroImage.sizes}
		fetchpriority="high"
	/>
	<Hero />
	<About />
	<Services />
	<Gallery />
	<FAQ />
	<Booking />
	<PhotoBand />
	<Footer />
</BaseLayout>
