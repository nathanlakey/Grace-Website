---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import Booking from '../components/Booking.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Footer from '../components/Footer.astro';
import { heroImage } from '../data/hero';

const heroPreload = await getImage({
	src: heroImage.src,
	widths: [...heroImage.widths],
	format: heroImage.format,
});
---

<BaseLayout>
	<link
		slot="head"
		rel="preload"
		as="image"
		type="image/webp"
		href={heroPreload.src}
		imagesrcset={heroPreload.srcSet.attribute}
		imagesizes={heroImage.sizes}
		fetchpriority="high"
	/>
	<div class="page-wrap">
		<div class="glitter-thread" aria-hidden="true"></div>
		<Hero />
		<About />
		<Services />
		<Gallery />
		<FAQ />
		<Booking />
		<PhotoBand />
		<Footer />
	</div>
</BaseLayout>

<style>
	.page-wrap {
		position: relative;
		width: 100%;
		overflow-x: clip;
	}

	.glitter-thread {
		display: none;
	}

	@media (max-width: 767px) {
		.glitter-thread {
			display: block;
			position: absolute;
			top: 0;
			right: -24px;
			width: 110px;
			height: 100%;
			opacity: 0.85;
			background-image: url('/images/glitter-thread-mobile.png');
			background-repeat: repeat-y;
			background-size: 110px 674px;
			background-position: right top;
			pointer-events: none;
			z-index: 1;
		}
	}
</style>
